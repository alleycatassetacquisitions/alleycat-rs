{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (i.device_id) i.id, i.device_id, i.inspected_at, i.received_at, i.firmware_commit_hash, i.notes, i.powers_on, p.screen, p.primary_button, p.secondary_button, p.haptics, p.leds, p.power_switch, p.input_jack, p.output_jack, p.housing\n         FROM device_inspections i JOIN pdn_inspection_checks p ON p.inspection_id = i.id WHERE i.device_id = ANY($1)\n         ORDER BY i.device_id, i.inspected_at DESC, i.received_at DESC, i.id DESC",
