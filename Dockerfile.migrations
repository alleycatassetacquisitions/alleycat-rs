FROM rust:1.95.0-bookworm AS builder
RUN cargo install sqlx-cli --version 0.8.6 --locked \
    --no-default-features --features rustls,postgres

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates postgresql-client && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /usr/local/cargo/bin/sqlx /usr/local/bin/sqlx
COPY migrations migrations
COPY xtask/seed_db.sql seed_db.sql
COPY xtask/reset_remote_db.sql reset_remote_db.sql
ENTRYPOINT ["sqlx", "migrate", "run"]
